{
  "expo": {
    "name": "Zero a Cinquenta Premium",
    "slug": "zero-a-cinquenta-premium",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-premium.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rotech.zeroacinquentapremium"
    },
    "android": {
      "package": "com.rotech.zeroacinquentapremium",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptative-icon-premium.png",
        "backgroundColor": "#000000"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/adaptative-icon-premium.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-premium.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6bd0aede-2131-48cf-a520-ac6f6b27494c"
      }
    },
    "owner": "rotec",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6bd0aede-2131-48cf-a520-ac6f6b27494c"
    }
  }
}
