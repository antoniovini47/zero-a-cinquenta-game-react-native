{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_ADS": "production",
        "EXPO_PUBLIC_ANALYTICS": "on"
      }
    },
    "production-premium": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_VARIANT": "premium",
        "EXPO_PUBLIC_ANALYTICS": "on"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
